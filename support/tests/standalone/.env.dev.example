# Run from this directory: npm run dev
# Uses ONLY local support_test, Redis and NATS, as the automated tests do.
# Copy this file to .env.dev only when overriding defaults. Never commit keys.
# Node.js >=22.18.0; Docker Desktop must be running.
# npm run dev:seed adds fixtures without replacing existing balances/payments.
# Stop the dev server before npm run dev:reset: resets ONLY the three fixtures
# and their local tickets. Telegram topics and uploaded files are not deleted.
# In another terminal: npm run dev:smoke verifies the running offline server.
DEV_PORT=3020
# Required x-internal-token for internal API and /__dev/* endpoints.
DEV_INTERNAL_TOKEN=standalone-dev-only
DEV_WORKER_ENABLED=true

# Default: fake Telegram delivery, visible at GET /__dev/events.
# Enable only with a dedicated TEST bot and forum group.
DEV_TELEGRAM_ENABLED=false
DEV_TELEGRAM_BOT_TOKEN=
DEV_TELEGRAM_CHAT_ID=
DEV_TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS tunnel URL ending in /v1/internal/tg-webhook.
# Empty: no webhook registration. Existing webhook is NOT deleted on exit.
DEV_TELEGRAM_WEBHOOK_URL=

# Example API calls (all fixture data is synthetic):
# GET  /healthz
# GET  /__dev/fixtures                       (x-internal-token required)
# POST /v1/internal/messages                (x-internal-token required)
# {"userId":"00000000-0000-4000-8000-000000000001","userNId":2100000001,"text":"Where is my withdrawal?","originDomain":"binodex.io"}
# POST /v1/internal/thread                  (x-internal-token required)
# {"userId":"00000000-0000-4000-8000-000000000001"}
# POST /__dev/reply                         (offline Telegram mode only)
# {"topicId":123,"text":"Your withdrawal is pending."}
# /__dev/reply simulates an operator message; use the topicId from thread/events.
# OpenRouter is not implemented yet. No AI calls are made by this server.
