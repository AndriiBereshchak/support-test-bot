{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "allowJs": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "paths": {
      "@apps/*": ["../../src/apps/*"],
      "@core/*": ["../../src/core/*"],
      "@config/*": ["../../src/config/*"],
      "@telegram/*": ["../../src/telegram/*"],
      "@prisma-support": ["./.generated/support"],
      "@prisma-exchange": ["./.generated/external"],
      "@prisma-affiliate": ["./.generated/external"],
      "@binodex/shared": ["./adapters/shared.ts"],
      "grammy/types": ["./node_modules/grammy/out/types.d.ts"],
      "*": ["./node_modules/*"]
    }
  },
  "include": ["../../src/**/*.ts", "../**/*.ts", "./environment.mjs"],
  "exclude": ["./node_modules", "./.generated"]
}
