{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "allowJs": true,
    "types": ["node"],
    "paths": {
      "@apps/*": ["../../src/apps/*"],
      "@core/*": ["../../src/core/*"],
      "@config/*": ["../../src/config/*"],
      "@telegram/*": ["../../src/telegram/*"],
      "@prisma-support": ["./.generated/support"],
      "@prisma-exchange": ["./.generated/external"],
      "@prisma-affiliate": ["./.generated/external"],
      "@binodex/shared": ["./adapters/shared.ts"],
      "grammy/types": ["../../../node_modules/grammy/out/types.d.ts"]
    }
  },
  "include": ["../../src/**/*.ts", "../**/*.ts", "./load-env.mjs"],
  "exclude": ["./.generated"]
}
