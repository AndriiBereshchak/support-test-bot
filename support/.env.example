# ─── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV="development"
APP_NAME="binodex-support"

# HTTP port. Not published publicly — exchange proxies both the user API and
# the Telegram webhook to it over the docker network.
APP_PORT="3020"

# Role gate, mirroring EXCHANGE_ROLE / AFFILIATE_ROLE:
#   api    — HTTP only (user API + Telegram webhook), no background loops
#   worker — inactivity sweeper only
#   all    — both (default; correct for dev and single-process deploys)
SUPPORT_ROLE="all"

# ─── Metrics ──────────────────────────────────────────────────────────────
# Separate port, published only on the WireGuard IP. Serves /metrics + /healthz.
METRICS_ENABLED="true"
METRICS_PORT="9464"

# ─── Auth ─────────────────────────────────────────────────────────────────
# Shared secret for the exchange -> support hop, sent as `x-internal-token`.
# This is the ENTIRE trust boundary of /v1/internal/*: anything on the docker
# network that knows it can read and write any user's support thread.
# REQUIRED in production; empty in dev/test skips the guard.
SUPPORT_INTERNAL_TOKEN=""

# ─── Telegram ─────────────────────────────────────────────────────────────
# Bot token from @BotFather. REQUIRED in production.
SUPPORT_BOT_TOKEN=""
# Forum supergroup holding one topic per ticket. Negative id, e.g. -1001234567890.
# REQUIRED in production.
SUPPORT_CHAT_ID=""
# Echoed by Telegram on every webhook call as `X-Telegram-Bot-Api-Secret-Token`.
# Requests without a match are dropped before the body is parsed.
# REQUIRED in production.
SUPPORT_WEBHOOK_SECRET=""
# Public URL Telegram posts updates to, e.g.
# https://api.binodex.io/v1/support/tg-webhook. Empty = don't register a
# webhook at boot (local dev / tests).
SUPPORT_WEBHOOK_URL=""

# ─── Data ─────────────────────────────────────────────────────────────────
# Own database. REQUIRED everywhere — the service refuses to boot without it.
DATABASE_SUPPORT="postgresql://user:pass@127.0.0.1:5432/support"
# Cross-service READ-ONLY client (ticket info card: nId, email, balances).
# Read straight from process.env by the generated exchange prisma client, so it
# never appears in src/config/env.ts — but the service still needs it set.
DATABASE_EXCHANGE="postgresql://user:pass@127.0.0.1:5432/exchange"

REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

NATS_URL="nats://127.0.0.1:4222"
NATS_USER=""
NATS_PASSWORD=""

# ─── Files ────────────────────────────────────────────────────────────────
# Attachment bytes are written here and served read-only by exchange at
# /support-files/*, which is what makes links resolve on every mirror domain
# without per-mirror nginx work. Must be the same volume on both containers.
SUPPORT_FILES_DIR="/app/storage/support"
# Hard ceiling for a single upload, in bytes. Telegram caps BOT DOWNLOADS at
# 20 MB, so anything larger can be sent by an agent but never fetched by us —
# keep the two aligned.
SUPPORT_MAX_UPLOAD_SIZE="20M"

# ─── Storage limits ───────────────────────────────────────────────────────
# Four layers on top of the per-file cap above, because that cap alone bounds
# one upload and nothing else: without these, thirty scripted 20 MB posts fill
# 600 MB, and nothing ever gives any of it back.
#
# Anything unparseable here falls back to the default rather than to "no
# limit" — a typo must not silently switch a guard off.

# Days an attachment's BYTES live before the retention pass unlinks them. The
# database row survives forever (the chat still shows that a file was sent, and
# its name) and Telegram keeps its own copy of every relayed file indefinitely,
# so support can still open it in the topic — 7 days only decides how long the
# VOLUME holds it. Tickets are answered in hours; a week is the far side of
# "the user might still reopen this".
SUPPORT_FILE_RETENTION_DAYS="7"

# Bytes ONE user may hold on the volume at once, non-purged and excluding files
# an agent sent them. 200 MB = ten of the largest uploads we accept: far past
# any real ticket, small enough that even a hundred abusive accounts cannot
# fill the disk between two retention passes. Over it the upload is refused
# with 413.
SUPPORT_USER_STORAGE_QUOTA="200M"

# Uploads one user may start per hour (rolling). A person attaching evidence
# sends a handful, so 30 never touches real traffic — it exists to cap a loop
# that would otherwise burn the quota above in seconds. Over it: 429.
SUPPORT_UPLOAD_RATE_PER_HOUR="30"

# The size the operator wants the whole support-files volume capped at. Past it
# EVERY upload is refused (507) — including the Telegram relay, because the
# volume is shared with exchange and one undelivered attachment (the agent is
# told, and Telegram still has the file) is cheaper than a host that can no
# longer write. Crossing it logs an error every retention pass: it needs a
# human to raise the cap, grow the volume, or shorten retention.
SUPPORT_STORAGE_QUOTA="50G"

# ─── Behaviour ────────────────────────────────────────────────────────────
# Idle hours after which the sweeper closes an OPEN ticket.
SUPPORT_IDLE_CLOSE_HOURS="48"

# ─── Relay retry ──────────────────────────────────────────────────────────
# The worker re-sends user messages that never reached the Telegram topic (an
# IN message with no tg_message_id). Defaults suit any deployment; raise the
# batch only if a long outage leaves a backlog worth draining faster.
# How often the worker looks for them, in seconds.
SUPPORT_RELAY_RETRY_INTERVAL_SEC="30"
# Messages per pass. The whole support group only takes ~20 sends a minute.
SUPPORT_RELAY_RETRY_BATCH_SIZE="25"
# Attempts before the message is escalated to Sentry and left alone. Past this
# the cause is structural (topic deleted, bot kicked, wrong chat id).
SUPPORT_RELAY_RETRY_MAX_ATTEMPTS="6"
# Grace period, in seconds, before the loop touches a fresh message — the
# inline relay in the API owns it until then.
SUPPORT_RELAY_RETRY_MIN_AGE_SEC="15"

# ─── Sentry ───────────────────────────────────────────────────────────────
# Unlike the other services there is NO hardcoded fallback DSN — empty means
# Sentry stays off rather than reporting into exchange's issue stream.
SENTRY_DSN=""
SENTRY_ERROR_SAMPLE_RATE="1.0"
SENTRY_TRACES_SAMPLE_RATE="0"

# Logging. LOG_LEVEL: error|warn|info|http|verbose|debug|silly — defaults to
# `info` in production and `debug` elsewhere; an unrecognised value falls back
# rather than silencing the service. LOG_FORMAT=json emits one JSON object per
# line for a log aggregator (default is the human-readable line).
LOG_LEVEL=
LOG_FORMAT=
# ANSI colours. Unset = follow the terminal (so a container writes none).
# `true` forces them on for reading `docker compose logs`, at the cost of
# escape codes in the stored journal; `false` forces them off.
LOG_COLOR=

# ─── Zhora ────────────────────────────────────────────────────────────────
# Off by default. Key and all operation model IDs are required when enabled.
# This block configures the assistant; AI calls are connected separately.
ZHORA_ENABLED="false"
ZHORA_OPENROUTER_API_KEY=""
# Explicit OpenRouter model IDs; choose them before enabling the assistant.
ZHORA_MODEL_TRANSLATE=""
ZHORA_MODEL_REPLY=""
ZHORA_MODEL_FIX=""
ZHORA_MODEL_BRIEF=""
ZHORA_MODEL_TAG=""
ZHORA_MODEL_CLUSTER=""
ZHORA_MODEL_DRAFT=""
ZHORA_MODEL_EMBEDDING=""
# Positive USD amount. Spending enforcement is implemented in the budget block.
ZHORA_MONTHLY_BUDGET_USD="300"
# Initial technical defaults, not values specified by the task.
# Tune against the selected model: request timeout (ms) and max output tokens.
ZHORA_TIMEOUT_MS="30000"
ZHORA_MAX_OUTPUT_TOKENS="2048"
