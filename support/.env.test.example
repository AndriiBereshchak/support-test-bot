# Copy to .env.test. Values match docker-compose.test.yml.
#
# NODE_ENV=test is load-bearing: it disables Sentry (see src/instrument.ts) and
# lets the internal-token and Telegram-webhook guards run in open mode, so tests
# can call /v1/internal/* without a token.
NODE_ENV="test"
APP_NAME="binodex-support-test"
APP_PORT="3020"

# No metrics server during tests — it would bind a port per test process.
METRICS_ENABLED="false"

DATABASE_SUPPORT="postgresql://test:test@127.0.0.1:55432/support_test"
DATABASE_EXCHANGE="postgresql://test:test@127.0.0.1:55432/support_test"

REDIS_HOST="127.0.0.1"
REDIS_PORT="16379"
REDIS_PASSWORD=""

NATS_URL="nats://127.0.0.1:14222"
NATS_USER=""
NATS_PASSWORD=""

# Empty = the guards are skipped (NODE_ENV != production) and no webhook is
# registered at boot. Leave them empty unless a test exercises the guard itself.
SUPPORT_INTERNAL_TOKEN=""
SUPPORT_BOT_TOKEN=""
SUPPORT_WEBHOOK_SECRET=""
SUPPORT_WEBHOOK_URL=""

# NOT optional for the integration suite. `updates.isSupportChat` compares every
# update's chat id against this, so an empty value makes the router silently
# drop every Telegram update and the tests would pass for the wrong reason.
# tests/setup.ts falls back to the same value if this is left empty.
SUPPORT_CHAT_ID="-1002000000001"

SUPPORT_FILES_DIR="./.tmp/support-files"
SUPPORT_MAX_UPLOAD_SIZE="20M"
SUPPORT_IDLE_CLOSE_HOURS="48"
SUPPORT_ROLE="all"

SENTRY_DSN=""
