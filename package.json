{
  "name": "binodex-support-export",
  "version": "0.0.0",
  "private": true,
  "description": "Local development and test tools for the support service export",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "postinstall": "node support/tests/standalone/run.mjs generate",
    "generate": "node support/tests/standalone/run.mjs generate",
    "typecheck": "node support/tests/standalone/run.mjs typecheck",
    "build": "node support/tests/standalone/run.mjs dev-build",
    "test": "node support/tests/standalone/run.mjs unit",
    "test:integration": "node support/tests/standalone/run.mjs integration",
    "test:all": "node support/tests/standalone/run.mjs all",
    "infra:up": "node support/tests/standalone/run.mjs infra",
    "db:prepare": "node support/tests/standalone/run.mjs database",
    "db:studio": "node support/tests/standalone/run.mjs studio",
    "dev": "node support/tests/standalone/run.mjs dev",
    "dev:build": "node support/tests/standalone/run.mjs dev-build",
    "dev:seed": "node support/tests/standalone/run.mjs dev-seed",
    "dev:reset": "node support/tests/standalone/run.mjs dev-reset",
    "dev:smoke": "node support/tests/standalone/dev-smoke.mjs",
    "format:check": "prettier --check package.json \"support/tests/standalone/*.{mjs,ts,json}\" \"support/tests/standalone/{adapters,dev}/**/*.ts\""
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@grpc/grpc-js": "^1.12.2",
    "@grpc/proto-loader": "^0.7.13",
    "@prisma/client": "^6.15.0",
    "@sentry/node": "^9.35.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.0.1",
    "fastify": "^5.10.0",
    "grammy": "^1.45.1",
    "ioredis": "^5.3.2",
    "module-alias": "^2.2.2",
    "nats": "^2.29.0",
    "prisma": "^6.15.0",
    "prom-client": "^15.1.3",
    "sharp": "^0.34.2",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "npm-run-all": "^4.1.5",
    "prettier": "3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vitest": "^1.6.0"
  },
  "packageManager": "yarn@4.9.4",
  "resolutions": {
    "@opentelemetry/api": "1.9.0"
  }
}
